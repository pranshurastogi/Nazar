# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
LOG_LEVEL=info

# Arkiv Tiramisu testnet (chain 7738577)
ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
ARKIV_WS_URL=wss://rpc.tiramisu.db-chain.testnet.arkiv.network
# Optional access key from https://hub.arkiv.network/access-keys (raises rate limits)
ARKIV_API_KEY=

# Publisher wallet. Generate with: pnpm cli wallet:new   Fund at https://hub.arkiv.network/faucet
NAZAR_PUBLISHER_PRIVATE_KEY=
NAZAR_ROOT_ADDRESS=
# dry-run builds and simulates every entity without sending; live writes to Tiramisu
NAZAR_PUBLISH_MODE=dry-run

# Harvesting etiquette
NAZAR_HOST_DELAY_MS=10000
NAZAR_HTTP_TIMEOUT_MS=60000
# Comma list of hosts whose broken TLS chains we tolerate (read-only public documents)
NAZAR_INSECURE_TLS_HOSTS=
# Comma list of source ids to run (empty = all)
NAZAR_SOURCES=

# Extraction
NAZAR_OCR_ENABLED=true
NAZAR_OCR_LANG=eng
# Optional: grounded LLM fallback for rows the deterministic parser rejects
ANTHROPIC_API_KEY=
NAZAR_LLM_MODEL=claude-haiku-5-5

# API
PORT=8787
NAZAR_CORS_ORIGINS=http://localhost:3000,http://localhost:3123
