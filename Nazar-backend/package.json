{
  "name": "nazar-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Nazar pipeline: harvest Indian drug-regulator alert PDFs, extract batch rows (text layer, OCR, grounded LLM fallback), resolve, and publish to Arkiv. Plus a read API for the web app.",
  "author": "Pranshu Rastogi",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/api/main.ts",
    "start": "tsx src/api/main.ts",
    "cli": "tsx src/cli.ts",
    "pipeline": "tsx src/cli.ts run",
    "worker": "tsx src/cli.ts worker",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "NAZAR_LIVE_TESTS=1 vitest run test/live"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@arkiv-network/sdk": "0.8.0",
    "@hono/node-server": "^2.1.5",
    "@napi-rs/canvas": "^1.0.11",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "croner": "^10.0.1",
    "dotenv": "^18.0.8",
    "fastest-levenshtein": "^1.0.16",
    "hono": "^4.13.13",
    "pdfjs-dist": "^6.4.299",
    "pino": "^10.4.0",
    "tesseract.js": "^7.0.0",
    "undici": "^8.12.2",
    "viem": "^2.57.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
