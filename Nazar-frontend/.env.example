# Copy to .env.local and adjust. NEXT_PUBLIC_* values are baked into the build,
# so rebuild after changing them. All three are public: no secrets belong here.

# Nazar HTTP API (Nazar-backend `pnpm serve`). Optional. When set, it is tried first
# for every check and feed page. When unset:
#   - `next dev` uses http://localhost:8787;
#   - a production build (`next build`, Vercel) skips the API entirely and answers from
#     Arkiv, then demo data, so a deployed site never calls a visitor's localhost.
# Set it to a public HTTPS URL in production to use a hosted API, or to "off" to skip the
# API in development too. The e2e fallback/mock suites build with http://localhost:8787.
# NEXT_PUBLIC_NAZAR_API_URL=https://api.example.org

# Arkiv Tiramisu RPC. Used directly from the browser when the API is unreachable,
# so checks keep working even if every Nazar server is down.
NEXT_PUBLIC_ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network

# Wallet that publishes Nazar's alerts. Arkiv queries only trust entities created by it.
NEXT_PUBLIC_NAZAR_PUBLISHER=0xd06d85Eb20f126f796E4a341b711B1a757c66bD2
